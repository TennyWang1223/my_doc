+// A block barrier that orders LDS only: __syncthreads() also waits for every
+// outstanding global store of the wave, here the remote sends, whose acks take
+// about one more fabric trip than the peers' data took to arrive.
+DINLINE void lamport_lds_barrier()
+{
+    __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local");
+    __builtin_amdgcn_s_barrier();
+    __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local");
+}
+
+// v of lane ^ OFF (wave32) in registers: DPP row_xmask within a row of 16,
+// permlanex16 across the two rows. __shfl_xor goes through ds_bpermute, an
+// LDS round trip per step.
+template <int OFF>
+DINLINE float lamport_xor_lane(float v)
+{
+    const int i = __builtin_bit_cast(int, v);
+    int r;
+    if constexpr(OFF == 16)
+        r = __builtin_amdgcn_permlanex16(i, i, 0x76543210, 0xfedcba98, false, false);
+    else
+        r = __builtin_amdgcn_update_dpp(i, i, 0x160 + OFF, 0xf, 0xf, false); // row_xmask:OFF
+    return __builtin_bit_cast(float, r);
+}
+
+// The 32-lane butterfly of block_allreduce_f32 (xor 16, 8, 4, 2, 1), the same
+// adds in the same order, every lane gets the result.
+template <bool kMax>
+DINLINE float lamport_wave_allreduce(float p)
+{
+    p = kMax ? fmaxf(p, lamport_xor_lane<16>(p)) : p + lamport_xor_lane<16>(p);
+    p = kMax ? fmaxf(p, lamport_xor_lane<8>(p)) : p + lamport_xor_lane<8>(p);
+    p = kMax ? fmaxf(p, lamport_xor_lane<4>(p)) : p + lamport_xor_lane<4>(p);
+    p = kMax ? fmaxf(p, lamport_xor_lane<2>(p)) : p + lamport_xor_lane<2>(p);
+    p = kMax ? fmaxf(p, lamport_xor_lane<1>(p)) : p + lamport_xor_lane<1>(p);
+    return p;
+}
+
+// Sum (or max) of the row's wave-group partials in group order, as
+// block_allreduce_f32 folds its waves: thread k of the block owns group
+// threadIdx.x / 32 + k * (blockDim.x / 32) of each of its PACKS packs. One
+// barrier: after it every wave folds the partials itself (lane g holds partial
+// g, summed in order from lane 0 with readlane), so no second barrier hands a
+// result around. The sum and the max instantiate separate LDS arrays, so a
+// fast wave's amax partials cannot overwrite sum partials a slow wave reads.
+template <bool kMax, int PACKS>
+DINLINE float lamport_row_allreduce(const float (&v)[PACKS], int row_groups)
+{
+    __shared__ float partial[32];
+    const int lane  = threadIdx.x % kLamportWave;
+    const int waves = blockDim.x / kLamportWave;
+#pragma unroll
+    for(int k = 0; k < PACKS; ++k)
+    {
+        const float p = lamport_wave_allreduce<kMax>(v[k]);
+        if(lane == 0)
+            partial[threadIdx.x / kLamportWave + k * waves] = p;
+    }
+    lamport_lds_barrier();
+    // max is exact (and the amax partials are >= 0): any order
+    if constexpr(kMax)
+        return lamport_wave_allreduce<true>(lane < row_groups ? partial[lane] : 0.f);
+    // every lane reads the same address (an LDS broadcast) and adds on the
+    // VALU: a readlane loop would queue every wave of the CU on its SALU
+    float r = partial[0];
+    for(int g = 1; g < row_groups; ++g)
+        r += partial[g];
+    return r;
+}
